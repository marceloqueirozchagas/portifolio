{
  "name": "marcelo-portfolio",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
